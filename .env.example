# Versão da imagem (mude a cada entrega para permitir rollback)
SHEETS_VERSION=2.2.2
# Porta local (o Caddy do host faz o TLS e encaminha para 127.0.0.1:SHEETS_PORT)
SHEETS_PORT=8958
# E-mail do admin master (criado na primeira subida)
SHEETS_MASTER_EMAIL=admin@example.com
# Senha inicial do master (opcional). Vazio: o sistema gera uma e mostra em `docker logs gplansis-sheets`.
# Em qualquer caso, a troca é obrigatória no primeiro acesso.
SHEETS_MASTER_PASSWORD=
# Segredo que cifra a chave da IA guardada no banco. O deploy.sh gera um se estiver vazio. Não troque depois de salvar a chave.
SHEETS_SECRET=
# Chave da IA: o caminho normal é Configurações › Inteligência artificial (admin master). Esta variável é só alternativa.
ANTHROPIC_API_KEY=
SHEETS_AI_MODEL=claude-opus-5-5
# Integração com o GPlanSiS|Docs: mesmo valor de INTEGRACAO_SHEETS_SEGREDO no .env do Docs. Vazio = desligada.
SHEETS_DOCS_SEGREDO=
SHEETS_DOCS_URL=https://docs.gplansis.com
SHEETS_URL=https://sheets.gplansis.com
